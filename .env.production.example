APP_NAME="UNIK Event Solutions"
APP_ENV=production
APP_KEY=                       # diisi otomatis oleh: php artisan key:generate
APP_DEBUG=false
APP_URL=https://unikcomunication.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/unik/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

BCRYPT_ROUNDS=12

# false = staging (robots Disallow + noindex). Ubah ke true HANYA saat go-live.
SITE_INDEXABLE=false
